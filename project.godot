; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="借一扇晴天"
config/description="双线叙事的第一人称探索游戏：阁楼里的慢时间，与微型太阳系里的十七分钟轮回。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/size/min_width=960
window/size/min_height=540

[dotnet]

project/assembly_name="借一扇晴天"

[physics]

; 物理插值：开着才不会「按 60Hz 整步跳」。
; ⚠ 2026-11-11 实测（tests/probe_frame_step.gd，1280x720 窗口）：
;   渲染 43.8 fps + 物理 60 Hz + 本项关闭
;   → 飞船每帧位移在 4.85 米 / 9.81 米之间来回跳（1 步 / 2 步），
;     画面上就是速度忽快忽慢的抖动。开启后渲染侧在两个物理快照之间插值，
;     任意帧率下位移都连续。
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/size=2048
anti_aliasing/quality/msaa_3d=2
limits/opengl/max_lights_per_object=16
environment/defaults/default_clear_color=Color(0.005, 0.008, 0.025, 1)
